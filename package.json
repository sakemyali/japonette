{
  "name": "japonette",
  "version": "0.1.0",
  "description": "A small CLI for the 42 API: browse active people at a campus and keep a local friends watchlist.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "japonette": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "keywords": [
    "42",
    "42api",
    "ecole42",
    "cli",
    "intra"
  ]
}
